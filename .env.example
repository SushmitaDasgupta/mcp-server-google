# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Path where OAuth tokens are stored (relative or absolute)
GOOGLE_TOKEN_PATH=token.json

# Optional: refresh token for non-interactive / Railway bootstraps
# Prefer this in production instead of relying on ephemeral token.json
GOOGLE_REFRESH_TOKEN=

# When false, skip writing refreshed tokens to disk (default in production if GOOGLE_REFRESH_TOKEN is set)
# Set true when using a Railway Volume at GOOGLE_TOKEN_PATH
# GOOGLE_TOKEN_PERSIST=true

# Shared secret for HTTP /mcp (required for `npm run dev:http` / Railway)
# Generate: openssl rand -hex 32
MCP_API_KEY=

# HTTP listen port (Railway injects PORT automatically)
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# development | production
NODE_ENV=development

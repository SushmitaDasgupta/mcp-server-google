# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Path where OAuth tokens are stored (relative or absolute)
GOOGLE_TOKEN_PATH=token.json

# Preferred for Railway / production: paste the full contents of token.json as one line
# Example: node -e "console.log(JSON.stringify(JSON.parse(require('fs').readFileSync('token.json','utf8'))))"
GOOGLE_TOKENS_JSON=

# Optional fallback if GOOGLE_TOKENS_JSON is unset: refresh_token string only
# GOOGLE_REFRESH_TOKEN=

# When false, skip writing refreshed tokens to disk (default in production if env tokens are set)
# Set true when using a Railway Volume at GOOGLE_TOKEN_PATH
# GOOGLE_TOKEN_PERSIST=true

# Optional shared secret for HTTP /mcp. When unset, /mcp is open (not recommended for public URLs).
# Generate: openssl rand -hex 32
MCP_API_KEY=

# HTTP listen port (Railway injects PORT automatically)
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# development | production
NODE_ENV=development
